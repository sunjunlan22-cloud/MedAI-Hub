---
import BaseLayout from '../layouts/BaseLayout.astro';
import researchData from '../data/auto/research.json';
import synonymsData from '../data/manual/search-synonyms.json';
import zhData from '../data/manual/research-zh.json';
import type { ResearchNews } from '../types/news';
import { formatDateZh } from '../lib/date';

const concepts = (synonymsData as any).concepts ?? [];

// 中文翻译索引：key = pmid:xxx / trial:NCTxxx / id:xxx
type ZhEntry = { key: string; titleZh?: string; abstractZh?: string };
const zhMap = new Map<string, ZhEntry>();
for (const e of zhData as ZhEntry[]) {
  if (e?.key) zhMap.set(e.key, e);
}

function zhKeyOf(n: ResearchNews): string {
  if (n.pmid) return `pmid:${n.pmid}`;
  if (n.trialId) return `trial:${n.trialId}`;
  return `id:${n.id}`;
}

function titleOf(n: ResearchNews): string {
  return n.titleZh ?? zhMap.get(zhKeyOf(n))?.titleZh ?? n.title;
}
function abstractOf(n: ResearchNews): string {
  return n.abstractZh ?? zhMap.get(zhKeyOf(n))?.abstractZh ?? n.abstract ?? '';
}

// 记录类型：已发表文献 vs 临床试验注册（resource 除外）
function isTrial(n: ResearchNews): boolean {
  const sid = (n as any).sourceId ?? '';
  return sid === 'clinicaltrials' || sid === 'chictr' || sid === 'euctr' || sid === 'ctis';
}

// 机构主页/资源导航不作为有发表日期的研究（contentType=resource 不入科研列表）
const news = (researchData as ResearchNews[])
  .filter((n) => (n as any).contentType !== 'resource')
  .sort((a, b) => {
    const ta = a.publishTime ? new Date(a.publishTime).getTime() : 0;
    const tb = b.publishTime ? new Date(b.publishTime).getTime() : 0;
    return tb - ta;
  });

const paperCount = news.filter((n) => !isTrial(n)).length;
const trialCount = news.filter((n) => isTrial(n)).length;

const studyTypes = [...new Set(news.map((n) => n.studyType))];

const studyTypeLabel: Record<string, string> = {
  'RCT': 'RCT / 临床研究',
  'cohort': '队列研究',
  'real-world': '真实世界研究',
  'meta-analysis': 'Meta 分析',
  'review': '综述',
  'preprint': '预印本',
  'other': '其他',
};

// 证据等级徽章颜色（按等级代码/说明）
function evidenceClass(level?: string | null) {
  if (!level) {
    return 'bg-neutral-100 text-neutral-600 border-neutral-200';
  }
  if (level.startsWith('1') || level.includes('专家共识') || level.includes('指南')) {
    return 'bg-emerald-50 text-emerald-700 border-emerald-200';
  }
  if (level.startsWith('2')) {
    return 'bg-blue-50 text-blue-700 border-blue-200';
  }
  return 'bg-neutral-100 text-neutral-600 border-neutral-200';
}

// 研究设计 / 临床试验状态（新增字段）
const studyDesignLabel: Record<string, string> = {
  rct: 'RCT',
  cohort: '队列研究',
  caseControl: '病例对照研究',
  metaAnalysis: 'Meta 分析',
  systematicReview: '系统综述',
  realWorld: '真实世界研究',
  preprint: '预印本',
  other: '其他',
};
const trialStatusLabel: Record<string, string> = {
  registered: '已注册',
  recruiting: '招募中',
  completed: '已完成',
  terminated: '已终止',
  unknown: '状态未知',
};

function formatDate(iso?: string | null) {
  return formatDateZh(iso);
}
---

<BaseLayout title="科研前沿" description="临床研究、课题线索与科研方法">
  <header class="mb-6">
    <h1 class="text-2xl font-semibold">科研前沿</h1>
    <p class="mt-2 text-neutral-600">
      追踪医学领域重要研究进展，关注临床试验、系统评价、指南共识及高质量原始研究，帮助医生和科研人员快速了解最新证据。
    </p>
    <div class="mt-3 flex flex-wrap items-center gap-2 text-sm">
      <span class="font-medium text-neutral-700">研究记录 · 共 {news.length} 条</span>
      <!-- 首层可点击：全部 / 已发表文献 / 临床试验注册 -->
      <div class="inline-flex flex-wrap gap-1 rounded-lg border border-neutral-200 bg-neutral-50 p-1">
        <button type="button" data-record-type="all" class="record-type-tab rounded-md px-3 py-1 text-sm font-medium bg-white text-blue-700 shadow-sm">全部</button>
        <button type="button" data-record-type="paper" class="record-type-tab rounded-md px-3 py-1 text-sm font-medium text-neutral-600 hover:text-neutral-900">已发表文献 {paperCount}</button>
        <button type="button" data-record-type="trial" class="record-type-tab rounded-md px-3 py-1 text-sm font-medium text-neutral-600 hover:text-neutral-900">临床试验注册 {trialCount}</button>
      </div>
    </div>
  </header>

  <!-- 顶部搜索框（默认搜索当前栏目：科研前沿） -->
  <div class="mb-5">
    <div class="relative">
      <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <path d="m21 21-4.35-4.35"></path>
      </svg>
      <input
        id="research-search"
        type="search"
        placeholder="搜索当前栏目（科研前沿）：病原体、疾病、药物、PMID、DOI…"
        class="w-full rounded-xl border border-neutral-300 bg-white py-2.5 pl-10 pr-4 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100"
      />
    </div>
  </div>

  <!-- 更多筛选（研究类型） -->
  <details class="mb-6 rounded-xl border border-neutral-200 bg-neutral-50 p-4">
    <summary class="cursor-pointer select-none text-sm font-semibold text-neutral-700 hover:text-neutral-900">
      更多筛选 · 研究类型
    </summary>
    <div class="mt-3 flex flex-wrap items-center gap-2">
      {
        studyTypes.map((t) => (
          <button
            type="button"
            data-type={t}
            class="type-tag rounded-full border border-neutral-300 bg-white px-3 py-1 text-xs text-neutral-600 transition hover:border-blue-500 hover:text-blue-600"
          >
            {studyTypeLabel[t] ?? t}
          </button>
        ))
      }
      <button id="research-reset" type="button" class="ml-1 text-xs text-blue-600 hover:text-blue-700 hover:underline">
        清除筛选
      </button>
    </div>
  </details>

  <!-- 结果计数 -->
  <p id="research-count" class="mb-4 text-sm text-neutral-500"></p>

  {
    news.length === 0 && (
      <div class="rounded-lg border border-dashed border-neutral-300 p-10 text-center text-neutral-500">
        暂无资讯数据
      </div>
    )
  }

  <ul id="research-list" class="space-y-5">
    {
      news.map((item) => (
        <li
          class="news-card rounded-xl border border-neutral-200 bg-white p-5 shadow-sm transition hover:shadow-md"
          data-type={item.studyType}
          data-record-type={isTrial(item) ? 'trial' : 'paper'}
          data-tags={item.tags.join(',')}
          data-search={`${titleOf(item)} ${abstractOf(item)} ${item.title} ${item.abstract ?? ''} ${item.pmid ?? ''} ${item.trialId ?? ''} ${item.tags.join(' ')} ${item.sourceName}`.toLowerCase()}
        >
          <div class="mb-3 flex flex-wrap items-center gap-2 text-xs">
            {/* 记录类型：已发表文献 vs 临床试验注册 */}
            <span class={`rounded px-2 py-0.5 font-semibold ${isTrial(item) ? 'bg-violet-50 text-violet-700' : 'bg-purple-50 text-purple-700'}`}>
              {isTrial(item) ? '临床试验注册' : '已发表文献'}
            </span>
            {/* 证据等级（突出，仅在有值时展示） */}
            {item.evidenceLevel && (
              <span class={`rounded border px-2 py-0.5 font-semibold ${evidenceClass(item.evidenceLevel)}`}>
                证据等级：{item.evidenceLevel}
              </span>
            )}
            <span class="rounded bg-blue-50 px-2 py-0.5 font-medium text-blue-700">
              {studyTypeLabel[item.studyType] ?? item.studyType}
            </span>
            {item.trialId && (
              <span class="rounded bg-violet-50 px-2 py-0.5 font-medium text-violet-700">
                临床试验 {item.trialId} · {trialStatusLabel[item.trialStatus ?? ''] ?? item.trialStatus ?? '状态未知'}
              </span>
            )}
            {item.trialId && item.studyDesign && (
              <span class="rounded bg-neutral-100 px-2 py-0.5 text-neutral-600">{studyDesignLabel[item.studyDesign] ?? item.studyDesign}</span>
            )}
            {item.pmid && (
              <span class="rounded bg-neutral-100 px-2 py-0.5 text-neutral-600">PMID: {item.pmid}</span>
            )}
            {item.sampleSize && (
              <span class="rounded bg-neutral-100 px-2 py-0.5 text-neutral-600">{item.sampleSize}</span>
            )}
            {item.isPreprint && (
              <span class="rounded bg-amber-50 px-2 py-0.5 font-medium text-amber-700">
                ⚠ 预印本 · 未同行评议
              </span>
            )}
            <span class="ml-auto text-neutral-400">
              {item.sourceName} · {isTrial(item) ? '更新' : '发表'} {formatDate(item.publishTime)}
            </span>
          </div>

          {/* 标题 → 详情页 */}
          <a
            href={`/research/${item.id}`}
            class="block text-lg font-medium text-neutral-900 hover:text-blue-600 hover:underline"
          >
            {titleOf(item)}
          </a>

          {/* 中文摘要（优先）或原文摘要 */}
          {abstractOf(item) ? (
            <div class="mt-3 rounded-lg border-l-4 border-blue-400 bg-blue-50/50 p-3">
              <p class="text-sm leading-relaxed text-neutral-800 line-clamp-2">
                <span class="mr-1 font-semibold text-blue-700">摘要：</span>
                {abstractOf(item)}
              </p>
            </div>
          ) : item.coreFindings ? (
            <div class="mt-3 rounded-lg border-l-4 border-blue-400 bg-blue-50/50 p-3">
              <p class="text-sm leading-relaxed text-neutral-800 line-clamp-2">
                <span class="mr-1 font-semibold text-blue-700">核心发现：</span>
                {item.coreFindings}
              </p>
            </div>
          ) : null}

          {/* 临床/科研启发（仅保留有依据的人工内容） */}
          {item.inspiration && (
            <p class="mt-3 text-sm leading-relaxed text-neutral-700">
              <span class="mr-1 font-medium text-neutral-900">临床启发：</span>
              {item.inspiration}
            </p>
          )}

          {/* 研究局限（次要信息） */}
          {item.limitations && (
            <p class="mt-2 text-xs leading-relaxed text-neutral-500">
              <span class="mr-1 font-medium">研究局限：</span>
              {item.limitations}
            </p>
          )}

          {/* 底部 Tag（可点击联动过滤）+ 研究原文入口 */}
          <div class="mt-3 flex flex-wrap items-center gap-1.5">
            {item.tags.map((tag) => (
              <button
                type="button"
                data-tag={tag}
                class="tag-btn rounded-full bg-neutral-100 px-2 py-0.5 text-xs text-neutral-600 transition hover:bg-amber-100 hover:text-amber-700"
              >
                #{tag}
              </button>
            ))}
            {item.sourceUrl && (
              <a
                href={item.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="ml-auto inline-flex items-center gap-1 text-xs font-medium text-blue-600 hover:text-blue-800"
              >
                研究原文 →
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ul>

  <div id="research-empty" class="hidden rounded-lg border border-dashed border-neutral-300 p-10 text-center text-neutral-500">
    没有匹配的文献
  </div>
</BaseLayout>

<script type="application/json" id="research-concepts" set:html={JSON.stringify(concepts).replace(/</g, '\\u003c')}></script>
<script>
  const concepts: any[] = JSON.parse(document.getElementById('research-concepts')!.textContent!);
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.news-card'));
  const typeTags = document.querySelectorAll<HTMLElement>('.type-tag');
  const tagBtns = document.querySelectorAll<HTMLElement>('.tag-btn');
  const recordTypeTabs = document.querySelectorAll<HTMLElement>('.record-type-tab');
  const searchInput = document.getElementById('research-search') as HTMLInputElement | null;
  const resetBtn = document.getElementById('research-reset');
  const countEl = document.getElementById('research-count')!;
  const emptyEl = document.getElementById('research-empty')!;

  const activeTypes = new Set<string>();
  const activeTags = new Set<string>();
  let activeRecordType = 'all';
  let query = '';

  // 中英文/缩写术语归一化：命中同义词概念时，用其全部规范术语参与匹配
  function expandQuery(raw: string): Set<string> {
    const q = raw.trim().toLowerCase();
    const terms = new Set<string>();
    if (!q) return terms;
    terms.add(q);
    for (const c of concepts) {
      const queries: string[] = c.queries ?? [];
      const hit = queries.some((t: string) => {
        const tl = t.toLowerCase();
        return q === tl || q.includes(tl);
      });
      if (hit) {
        (c.expansions ?? []).forEach((e: any) => terms.add(String(e).toLowerCase()));
      }
    }
    return terms;
  }

  function applyFilters() {
    let visible = 0;
    const terms = expandQuery(query);
    cards.forEach((card: HTMLElement) => {
      const type = card.dataset.type!;
      const recordType = card.dataset['recordType'] ?? 'paper';
      const tags = card.dataset.tags!.split(',');
      const searchText = card.dataset.search ?? '';

      const matchRecordType = activeRecordType === 'all' || activeRecordType === recordType;
      const matchType = activeTypes.size === 0 || activeTypes.has(type);
      const matchTags =
        activeTags.size === 0 ||
        Array.from(activeTags).some((t) => tags.includes(t));
      const matchSearch =
        terms.size === 0 || Array.from(terms).some((t) => searchText.includes(t));

      const show = matchRecordType && matchType && matchTags && matchSearch;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });

    countEl.textContent = `共 ${visible} 条记录`;
    emptyEl.classList.toggle('hidden', visible > 0);
  }

  function toggleRecordType(btn: HTMLElement) {
    activeRecordType = btn.dataset.recordType || 'all';
    recordTypeTabs.forEach((t) => {
      const active = t === btn;
      t.classList.toggle('bg-white', active);
      t.classList.toggle('text-blue-700', active);
      t.classList.toggle('shadow-sm', active);
      t.classList.toggle('text-neutral-600', !active);
      t.classList.toggle('hover:text-neutral-900', !active);
    });
    applyFilters();
  }

  function toggleType(btn: HTMLElement) {
    const value = btn.dataset.type!;
    const on = activeTypes.has(value);
    if (on) {
      activeTypes.delete(value);
      btn.classList.remove('border-blue-500', 'bg-blue-50', 'text-blue-600');
      btn.classList.add('border-neutral-300', 'bg-white', 'text-neutral-600');
    } else {
      activeTypes.add(value);
      btn.classList.add('border-blue-500', 'bg-blue-50', 'text-blue-600');
      btn.classList.remove('border-neutral-300', 'bg-white', 'text-neutral-600');
    }
    applyFilters();
  }

  function toggleTag(btn: HTMLElement) {
    const value = btn.dataset.tag!;
    const on = activeTags.has(value);
    if (on) {
      activeTags.delete(value);
      btn.classList.remove('bg-amber-100', 'text-amber-700');
      btn.classList.add('bg-neutral-100', 'text-neutral-600');
    } else {
      activeTags.add(value);
      btn.classList.add('bg-amber-100', 'text-amber-700');
      btn.classList.remove('bg-neutral-100', 'text-neutral-600');
    }
    applyFilters();
  }

  recordTypeTabs.forEach((btn) => btn.addEventListener('click', () => toggleRecordType(btn)));
  typeTags.forEach((btn) => btn.addEventListener('click', () => toggleType(btn)));
  tagBtns.forEach((btn) => btn.addEventListener('click', () => toggleTag(btn)));

  searchInput?.addEventListener('input', () => {
    query = searchInput.value.trim().toLowerCase();
    applyFilters();
  });

  resetBtn?.addEventListener('click', () => {
    activeTypes.clear();
    activeTags.clear();
    query = '';
    activeRecordType = 'all';
    if (searchInput) searchInput.value = '';
    recordTypeTabs.forEach((t) => {
      const active = t.dataset.recordType === 'all';
      t.classList.toggle('bg-white', active);
      t.classList.toggle('text-blue-700', active);
      t.classList.toggle('shadow-sm', active);
      t.classList.toggle('text-neutral-600', !active);
      t.classList.toggle('hover:text-neutral-900', !active);
    });
    typeTags.forEach((b) => {
      b.classList.remove('border-blue-500', 'bg-blue-50', 'text-blue-600');
      b.classList.add('border-neutral-300', 'bg-white', 'text-neutral-600');
    });
    tagBtns.forEach((b) => {
      b.classList.remove('bg-amber-100', 'text-amber-700');
      b.classList.add('bg-neutral-100', 'text-neutral-600');
    });
    applyFilters();
  });

  applyFilters();
</script>
