---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import industryData from '../data/auto/industry.json';
import researchData from '../data/auto/research.json';
import aiToolsData from '../data/manual/ai-tools.json';
import type { IndustryNews, ResearchNews } from '../types/news';

// —— 五大核心板块入口 ——
const sections = [
  {
    icon: '📰',
    name: '行业资讯',
    href: '/industry',
    color: 'bg-blue-50',
    desc: '关注医药行业政策、企业动态、药品市场与市场准入变化，为医药从业者提供及时的行业信息。',
  },
  {
    icon: '🔬',
    name: '科研前沿',
    href: '/research',
    color: 'bg-purple-50',
    desc: '追踪医学领域重要研究进展，关注临床试验、系统评价、指南共识及高质量原始研究。',
  },
  {
    icon: '📋',
    name: '抗感染指南',
    href: '/guides',
    color: 'bg-green-50',
    desc: '汇集国内外抗感染诊疗指南、专家共识及循证资料，支持快速检索与查阅。',
  },
  {
    icon: '🧮',
    name: '临床工具',
    href: '/tools',
    color: 'bg-amber-50',
    desc: '帮助医务人员快速完成临床评估与计算，浏览器本地运行，保护患者隐私。',
  },
  {
    icon: '🤖',
    name: 'AI工具',
    href: '/ai-tools',
    color: 'bg-cyan-50',
    desc: '发现适合医学临床、科研学习、医学教学及日常办公的 AI 工具，为医疗工作者提供实用参考。',
  },
];

// —— 临床工具（与 /tools 页面保持一致）——
const tools = [
  { title: '肌酐清除率', formula: 'Cockcroft-Gault', desc: '经典公式，用于肾功能评估与药物剂量调整。', href: '/tools/cockcroft-gault' },
  { title: 'eGFR', formula: 'CKD-EPI 2021', desc: '推荐公式，基于 Scr 估算肾小球滤过率。', href: '/tools/egfr' },
  { title: 'qSOFA / SOFA', formula: '脓毒症评分', desc: '快速筛查 + 完整器官功能衰竭评估。', href: '/tools/sofa' },
  { title: 'PaO₂/FiO₂ 氧合指数', formula: 'P/F 比', desc: '评估氧合功能与 ARDS 严重程度（柏林定义）。', href: '/tools/pf-ratio' },
  { title: 'CURB-65 评分', formula: 'CAP 严重度', desc: '社区获得性肺炎严重程度评估，指导诊疗决策。', href: '/tools/curb-65' },
  { title: 'APACHE II 评分', formula: '危重评分', desc: '急性生理与慢性健康评分，ICU 危重分层。', href: '/tools/apache-ii' },
  { title: 'ARC 筛查', formula: '肾清除过度', desc: '识别 CrCl 过高导致的抗菌药物剂量不足风险。', href: '/tools/arc' },
  { title: '抗感染药物剂量', formula: '肾功能调整参考表', desc: '常用抗感染药物在不同肾功能水平下的剂量对照。', href: '/tools/dosing-reference' },
];
const latestTools = tools.slice(0, 3);

// —— 行业资讯最新 3 条 ——
const industryNews = (industryData as IndustryNews[])
  .sort((a, b) => new Date(b.publishTime).getTime() - new Date(a.publishTime).getTime())
  .slice(0, 3);

// —— 科研前沿最新 3 条 ——
const researchNews = (researchData as ResearchNews[])
  .sort((a, b) => new Date(b.publishTime).getTime() - new Date(a.publishTime).getTime())
  .slice(0, 3);

// —— 抗感染指南最新 3 条（按年份倒序，排除草稿）——
const allGuides = await getCollection('guides', ({ data }) => !data.draft);
const latestGuides = allGuides
  .sort((a, b) => b.data.year - a.data.year)
  .slice(0, 3);

// —— AI 工具精选 3 个 ——
const aiTools = aiToolsData.featured;

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString('zh-CN', { month: '2-digit', day: '2-digit' });
}

const categoryBadgeClass: Record<string, string> = {
  '真菌与耐药': 'bg-pink-50 text-pink-700',
  'AMR': 'bg-red-50 text-red-700',
  '感染影像': 'bg-cyan-50 text-cyan-700',
  'AI临床': 'bg-violet-50 text-violet-700',
  '耐药监测': 'bg-orange-50 text-orange-700',
};
---

<BaseLayout title="首页" description="MedAI Hub — 聚合医学行业资讯、科研前沿、抗感染指南、临床实用工具与 AI 应用">

  <!-- Hero Section -->
  <section class="text-center">
    <h1 class="text-4xl font-semibold leading-tight sm:text-5xl">MedAI Hub</h1>
    <p class="mx-auto mt-4 max-w-3xl text-neutral-600">
      聚合医学行业资讯、科研前沿、抗感染指南、临床实用工具与AI应用，为医疗工作者、科研人员及医药行业从业者提供专业、便捷的医学信息检索与工作效率工具。
    </p>
  </section>

  <!-- 五大核心板块入口区 -->
  <section class="mt-12 grid grid-cols-2 gap-4 md:grid-cols-3 lg:grid-cols-5">
    {
      sections.map((s) => (
        <a
          href={s.href}
          class="group rounded-xl border border-neutral-200 bg-white p-5 text-center transition hover:border-blue-300 hover:shadow-md"
        >
          <span class={`mx-auto flex h-12 w-12 items-center justify-center rounded-lg text-2xl ${s.color}`}>{s.icon}</span>
          <h3 class="mt-3 text-base font-semibold text-neutral-900">{s.name}</h3>
          <p class="mt-1.5 text-xs leading-relaxed text-neutral-500">{s.desc}</p>
          <span class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-blue-600 opacity-0 transition group-hover:opacity-100">
            进入 →
          </span>
        </a>
      ))
    }
  </section>

  <!-- 内容聚合展示区 -->
  <section class="mt-14 grid gap-8 md:grid-cols-2 xl:grid-cols-3">

    <!-- 行业资讯 -->
    <div>
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-lg font-semibold">行业资讯</h2>
        <a href="/industry" class="text-sm text-blue-600 hover:underline">查看更多 →</a>
      </div>
      <ul class="space-y-3">
        {
          industryNews.map((item) => (
            <li class="rounded-lg border border-neutral-200 p-4 transition hover:border-neutral-400">
              <div class="mb-1 flex items-center gap-2 text-xs text-neutral-400">
                <span class={`rounded px-1.5 py-0.5 ${categoryBadgeClass[item.category] ?? 'bg-blue-50 text-blue-700'}`}>{item.category}</span>
                <span>{formatDate(item.publishTime)}</span>
              </div>
              <a href={`/industry/${item.id}`} class="line-clamp-2 text-sm font-medium text-neutral-900 hover:text-blue-600">
                {item.title}
              </a>
              <p class="mt-1.5 line-clamp-2 text-xs text-neutral-500">{item.summary}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- 科研前沿 -->
    <div>
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-lg font-semibold">科研前沿</h2>
        <a href="/research" class="text-sm text-blue-600 hover:underline">查看更多 →</a>
      </div>
      <ul class="space-y-3">
        {
          researchNews.map((item) => (
            <li class="rounded-lg border border-neutral-200 p-4 transition hover:border-neutral-400">
              <div class="mb-1 flex items-center gap-2 text-xs text-neutral-400">
                <span class="rounded bg-blue-50 px-1.5 py-0.5 text-blue-700">{item.studyType}</span>
                {item.isPreprint && <span class="rounded bg-amber-50 px-1.5 py-0.5 text-amber-700">预印本</span>}
                <span>{formatDate(item.publishTime)}</span>
              </div>
              <a href={`/research/${item.id}`} class="line-clamp-2 text-sm font-medium text-neutral-900 hover:text-blue-600">
                {item.title}
              </a>
              <p class="mt-1.5 line-clamp-2 text-xs text-neutral-500">{item.coreFindings}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- 抗感染指南 -->
    <div>
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-lg font-semibold">抗感染指南</h2>
        <a href="/guides" class="text-sm text-blue-600 hover:underline">查看更多 →</a>
      </div>
      <ul class="space-y-3">
        {
          latestGuides.map((guide) => (
            <li class="rounded-lg border border-neutral-200 p-4 transition hover:border-neutral-400">
              <div class="mb-1 flex items-center gap-2 text-xs text-neutral-400">
                <span class="rounded bg-green-50 px-1.5 py-0.5 text-green-700">{guide.data.year} 年</span>
                <span>{guide.data.organization}</span>
              </div>
              <a href={`/guides/${guide.slug}`} class="line-clamp-2 text-sm font-medium text-neutral-900 hover:text-blue-600">
                {guide.data.title}
              </a>
              <p class="mt-1.5 line-clamp-2 text-xs text-neutral-500">
                {guide.data.description || guide.data.docType.join(' / ')}
              </p>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- 临床工具 -->
    <div>
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-lg font-semibold">临床工具</h2>
        <a href="/tools" class="text-sm text-blue-600 hover:underline">查看更多 →</a>
      </div>
      <ul class="space-y-3">
        {
          latestTools.map((tool) => (
            <li class="rounded-lg border border-neutral-200 p-4 transition hover:border-neutral-400">
              <div class="mb-1 text-xs font-medium text-amber-600">{tool.formula}</div>
              <a href={tool.href} class="line-clamp-1 text-sm font-medium text-neutral-900 hover:text-blue-600">
                {tool.title}
              </a>
              <p class="mt-1.5 line-clamp-2 text-xs text-neutral-500">{tool.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>

    <!-- AI 工具 -->
    <div>
      <div class="mb-4 flex items-center justify-between">
        <h2 class="text-lg font-semibold">AI工具</h2>
        <a href="/ai-tools" class="text-sm text-blue-600 hover:underline">查看更多 →</a>
      </div>
      <ul class="space-y-3">
        {
          aiTools.map((tool) => (
            <li class="rounded-lg border border-neutral-200 p-4 transition hover:border-neutral-400">
              <div class="mb-1 text-xs font-medium text-cyan-600">{tool.badge}</div>
              <a href="/ai-tools" class="line-clamp-1 text-sm font-medium text-neutral-900 hover:text-blue-600">
                {tool.name}
              </a>
              <p class="mt-1.5 line-clamp-2 text-xs text-neutral-500">{tool.desc}</p>
            </li>
          ))
        }
      </ul>
    </div>

  </section>

</BaseLayout>
