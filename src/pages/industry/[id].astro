---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ScoreBadge from '../../components/ScoreBadge.astro';
import industryData from '../../data/auto/industry.json';
import type { IndustryNews } from '../../types/news';

export async function getStaticPaths() {
  return (industryData as IndustryNews[]).map((item) => ({
    params: { id: item.id },
    props: { item },
  }));
}

const { item } = Astro.props as { item: IndustryNews };

const factTypeLabel: Record<string, { text: string; class: string }> = {
  fact: { text: '事实', class: 'bg-neutral-100 text-neutral-700' },
  analysis: { text: '分析', class: 'bg-amber-50 text-amber-700' },
  forecast: { text: '预测', class: 'bg-purple-50 text-purple-700' },
};

const ft = factTypeLabel[item.factType];

// 内容类型（B4/B5 新增）
const contentTypeLabel: Record<string, { text: string; class: string }> = {
  policy: { text: '政策动态', class: 'bg-blue-50 text-blue-700 border border-blue-200' },
  approval: { text: '药品审批', class: 'bg-emerald-50 text-emerald-700 border border-emerald-200' },
  surveillance: { text: '耐药监测', class: 'bg-orange-50 text-orange-700 border border-orange-200' },
  news: { text: '行业动态', class: 'bg-neutral-100 text-neutral-600 border border-neutral-200' },
  resource: { text: '资源', class: 'bg-neutral-100 text-neutral-600 border border-neutral-200' },
};
const ct = contentTypeLabel[item.contentType ?? ''];

const approvalStatusLabel: Record<string, string> = {
  filed: '已受理',
  underReview: '审评中',
  approved: '已批准',
  rejected: '未批准',
  withdrawn: '已撤回',
};
const marketAccessTypeLabel: Record<string, string> = {
  nmpa: 'NMPA',
  fda: 'FDA',
  ema: 'EMA',
  pmda: 'PMDA',
  insurance: '医保',
  hospital: '医院',
};
const policyStatusLabel: Record<string, string> = {
  draft: '草案',
  published: '已发布',
  effective: '已生效',
  revised: '已修订',
  expired: '已失效',
};

// 从 abstract 中提取 GLASS 原始 PDF 链接，并分离正文
function extractPdfUrl(abstract?: string): string | null {
  if (!abstract) return null;
  const m = abstract.match(/官方 PDF:\s*(https?:\/\/\S+)/);
  return m ? m[1] : null;
}
const pdfUrl = extractPdfUrl(item.abstract);
const abstractText = item.abstract?.replace(/官方 PDF:\s*https?:\/\/\S+\s*/g, '').trim() ?? '';

function formatDate(iso: string) {
  return new Date(iso).toLocaleString('zh-CN', {
    year: 'numeric',
    month: '2-digit',
    day: '2-digit',
    hour: '2-digit',
    minute: '2-digit',
  });
}

const axes = [
  { label: '政策/医保影响度', value: item.scores.policyImpact },
  { label: '市场/销售额波及面', value: item.scores.marketImpact },
  { label: '产品/管线突破性', value: item.scores.breakthrough },
  { label: '企业/竞争格局影响', value: item.scores.competitiveImpact },
  { label: '时效性与权威可信度', value: item.scores.timelinessAuthority },
];
---

<BaseLayout title={item.title} description={item.summary}>
  <article class="mx-auto max-w-3xl">
    <!-- 返回链接 -->
    <a href="/industry" class="mb-6 inline-block text-sm text-blue-600 hover:underline">
      ← 返回行业资讯列表
    </a>

    <!-- 元信息 -->
    <div class="mb-4 flex flex-wrap items-center gap-2 text-xs">
      {ct && (
        <span class={`rounded border px-2 py-0.5 ${ct.class}`}>{ct.text}</span>
      )}
      <span class="rounded bg-blue-50 px-2 py-0.5 font-medium text-blue-700">{item.category}</span>
      <span class={`rounded px-2 py-0.5 ${ft.class}`}>{ft.text}</span>
      {item.isCluster && (
        <span class="rounded bg-emerald-50 px-2 py-0.5 text-emerald-700">多源聚合</span>
      )}
    </div>

    <!-- 标题 -->
    <h1 class="text-2xl font-semibold leading-tight">{item.title}</h1>

    <!-- 来源与时间 -->
    <div class="mt-3 text-sm text-neutral-500">
      来源：
      <a href={item.sourceUrl} target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline">
        {item.sourceName}
      </a>
      <span class="mx-2">·</span>
      <span>事件时间：{item.eventTime}</span>
      <span class="mx-2">·</span>
      <span>发布时间：{formatDate(item.publishTime)}</span>
    </div>

    <!-- 事实/分析/预测 区分提示（PRD 3.3） -->
    <div class="mt-4 rounded-md bg-amber-50 px-3 py-2 text-xs text-amber-700">
      本条资讯为「{ft.text}」类内容。事实为已证实信息，分析为基于事实的解读，预测为对未来趋势的判断，请审慎参考。
    </div>

    <!-- 耐药监测（GLASS）：结构化监测数据 -->
    {item.contentType === 'surveillance' && (
      <section class="mt-8">
        <h2 class="mb-3 text-lg font-semibold">耐药监测 · 结构化数据</h2>
        {(item.pathogens?.length ?? 0) > 0 && (
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <span class="text-sm font-medium text-neutral-500">病原体：</span>
            {item.pathogens!.map((p) => (
              <span class="rounded bg-amber-50 px-2 py-0.5 text-xs text-amber-700">{p}</span>
            ))}
          </div>
        )}
        {(item.drugs?.length ?? 0) > 0 && (
          <div class="mb-3 flex flex-wrap items-center gap-2">
            <span class="text-sm font-medium text-neutral-500">药物：</span>
            {item.drugs!.map((d) => (
              <span class="rounded bg-purple-50 px-2 py-0.5 text-xs text-purple-700">{d}</span>
            ))}
          </div>
        )}
        {abstractText ? (
          <div class="rounded-lg border border-neutral-200 bg-neutral-50 p-4">
            <p class="whitespace-pre-line text-sm leading-relaxed text-neutral-700">{abstractText}</p>
          </div>
        ) : (
          <p class="text-sm text-neutral-500">暂无结构化监测数据。</p>
        )}
        <p class="mt-2 text-xs text-neutral-400">分母 / 样本量：原文未提供，不自行推算。</p>
        {pdfUrl && (
          <a
            href={pdfUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-3 inline-flex items-center gap-1 rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700"
          >
            原始 PDF →
          </a>
        )}
      </section>
    )}

    <!-- 药品审批：状态 + 准入类型 + 文号 -->
    {item.contentType === 'approval' && (
      <section class="mt-8">
        <h2 class="mb-3 text-lg font-semibold">药品审批信息</h2>
        <div class="flex flex-wrap gap-2 text-sm">
          {item.approvalStatus && (
            <span class="rounded bg-emerald-50 px-3 py-1 font-medium text-emerald-700">
              审批状态：{approvalStatusLabel[item.approvalStatus] ?? item.approvalStatus}
            </span>
          )}
          {item.marketAccessType && (
            <span class="rounded bg-blue-50 px-3 py-1 font-medium text-blue-700">
              监管机构：{marketAccessTypeLabel[item.marketAccessType] ?? item.marketAccessType}
            </span>
          )}
          {item.externalId && (
            <span class="rounded bg-neutral-100 px-3 py-1 text-neutral-700">文号 / 编号：{item.externalId}</span>
          )}
        </div>
      </section>
    )}

    <!-- 政策动态：政策状态 + 文号 -->
    {item.contentType === 'policy' && (
      <section class="mt-8">
        <h2 class="mb-3 text-lg font-semibold">政策信息</h2>
        <div class="flex flex-wrap gap-2 text-sm">
          {item.policyStatus && (
            <span class="rounded bg-blue-50 px-3 py-1 font-medium text-blue-700">
              政策状态：{policyStatusLabel[item.policyStatus] ?? item.policyStatus}
            </span>
          )}
          {item.externalId && (
            <span class="rounded bg-neutral-100 px-3 py-1 text-neutral-700">文号：{item.externalId}</span>
          )}
        </div>
      </section>
    )}

    <!-- AI 摘要 -->
    <section class="mt-8">
      <h2 class="mb-2 text-lg font-semibold">AI 摘要</h2>
      <p class="leading-relaxed text-neutral-700">{item.summary}</p>
    </section>

    <!-- 行业影响评估 -->
    <section class="mt-6">
      <h2 class="mb-2 text-lg font-semibold">行业影响评估</h2>
      <p class="leading-relaxed text-neutral-700">{item.impact}</p>
    </section>

    <!-- 五轴评分 -->
    <section class="mt-8">
      <h2 class="mb-3 text-lg font-semibold">五轴评分</h2>
      <ScoreBadge totalScore={item.totalScore} axes={axes} />
      <p class="mt-2 text-xs text-neutral-400">满分 50 分，准入线 35 分（双 Agent 审核通过）</p>
    </section>

    <!-- 标签 -->
    {item.tags.length > 0 && (
      <section class="mt-8">
        <h2 class="mb-2 text-lg font-semibold">标签</h2>
        <div class="flex flex-wrap gap-2">
          {item.tags.map((tag) => (
            <span class="rounded-full bg-neutral-100 px-3 py-1 text-sm text-neutral-600">#{tag}</span>
          ))}
        </div>
      </section>
    )}

    <!-- 外链 -->
    <section class="mt-8 border-t border-neutral-200 pt-6">
      <a
        href={item.sourceUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 rounded-lg bg-neutral-900 px-4 py-2 text-sm font-medium text-white hover:bg-neutral-700"
      >
        阅读原文 →
      </a>
      <p class="mt-2 text-xs text-neutral-400">本站仅存储结构化摘要与外链，不存储原文全文。</p>
    </section>
  </article>
</BaseLayout>
