---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;

// 六大一级导航（关于本站收进页脚）
const nav = [
  { label: '首页', href: '/' },
  { label: '抗感染指南', href: '/guides' },
  { label: '科研前沿', href: '/research' },
  { label: '行业资讯', href: '/industry' },
  { label: '临床工具', href: '/tools' },
  { label: 'AI工具', href: '/ai-tools' },
];

function isActive(href: string) {
  const path = Astro.url.pathname;
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title} | MedAI Hub</title>
    <meta
      name="description"
      content={description ?? '医药行业资讯、临床科研前沿、抗感染指南与临床工具平台'}
    />
    <meta name="generator" content={Astro.generator} />
    {canonical && <link rel="canonical" href={canonical} />}
  </head>
  <body class="min-h-screen bg-white font-sans text-neutral-900 antialiased">
    <header class="sticky top-0 z-50 border-b border-neutral-200 bg-white/95 backdrop-blur">
      <div
        class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-3 md:h-14 md:flex-row md:items-center md:justify-between"
      >
        <a href="/" class="text-lg font-semibold tracking-tight">MedAI Hub</a>
        <div class="flex flex-col gap-2 md:flex-row md:items-center md:gap-3">
          <ul class="flex flex-wrap items-center gap-1">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    class={`rounded-md px-2.5 py-1.5 text-sm transition hover:bg-neutral-100 hover:text-neutral-900 ${
                      isActive(item.href)
                        ? 'bg-blue-50 font-medium text-blue-700'
                        : 'text-neutral-600'
                    }`}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
          <!-- 核心搜索框（统一结果页 /search） -->
          <form action="/search" method="get" role="search" class="w-full md:w-56">
            <div class="relative">
              <svg class="pointer-events-none absolute left-2.5 top-1/2 h-4 w-4 -translate-y-1/2 text-neutral-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="11" cy="11" r="8" />
                <path d="m21 21-4.3-4.3" />
              </svg>
              <input
                type="search"
                name="q"
                placeholder="搜索文献、指南、资讯、病原体…"
                aria-label="全站搜索"
                class="w-full rounded-lg border border-neutral-300 bg-white py-1.5 pl-8 pr-3 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-100"
              />
            </div>
          </form>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 py-12">
      <slot />
    </main>

    <footer class="border-t border-neutral-200 bg-neutral-50">
      <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-sm text-neutral-500 md:flex-row md:items-center md:justify-between">
        <p class="text-xs leading-relaxed">
          本站内容仅供医学专业人士参考，不构成诊疗建议；AI 工具信息以各官网为准。
        </p>
        <a href="/about" class="text-neutral-500 hover:text-blue-600 hover:underline">关于本站</a>
      </div>
    </footer>
  </body>
</html>
